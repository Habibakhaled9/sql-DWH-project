/*
==================================
creating database and schemas
==============================
WARNING!!
running this will drop the entire data_warehouse DB after checking if it already exists.
so proceed with caution and ensure you have proper backups before running this script.
*/


use master;
go

--drop and recreate the 'data_warehouse' database 
if exists (select 1 from sys.databases where name = 'data_warehouse')
begin 
alter database data_warehouse set single_user with rollback immediate;
drop database data_warehouse;
end;
go 


---create the data_warehouse DB 
create database data_warehouse;



use data_warehouse;
go

create schema bronze ;
go 
create schema silver;
go
create schema gold;
go

